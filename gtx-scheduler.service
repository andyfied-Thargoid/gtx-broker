[Unit]
Description=GTX Scheduler Daemon
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=andyfied
Group=andyfied
WorkingDirectory=/home/andyfied/src/gtx-broker
Environment="PATH=/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 -m gtx_broker.daemon
Restart=on-failure
RestartSec=5

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
