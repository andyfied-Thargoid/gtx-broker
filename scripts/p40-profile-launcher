#!/bin/bash
# p40-profile-launcher - Profile-specific launcher for llama-server with vision support
# Reads active profile from /etc/llama-cpp/p40-active.conf

set -euo pipefail

ACTIVE_CONFIG="/etc/llama-cpp/p40-active.conf"

if [[ ! -L "$ACTIVE_CONFIG" ]] || [[ ! -f "$ACTIVE_CONFIG" ]]; then
    echo "Error: Active config not found or not a symlink: $ACTIVE_CONFIG" >&2
    exit 1
fi

# Resolve the symlink to get actual profile config
CONF_FILE=$(readlink -f "$ACTIVE_CONFIG")
PROFILE_NAME=$(basename "$CONF_FILE" .conf)

if [[ ! -f "$CONF_FILE" ]]; then
    echo "Error: Profile config not found: $CONF_FILE" >&2
    exit 1
fi

source "$CONF_FILE"

BASE_ARGS=(
    "--model" "${MODEL_PATH}"
    "--chat-template" "${CHAT_TEMPLATE}"
    "--n-gpu-layers" "${GPU_LAYERS}"
    "--ctx-size" "${CONTEXT_SIZE}"
    "--parallel" "${SERVER_SLOTS}"
    "--mmap"
    "--host" "127.0.0.1"
    "--port" "11436"
)

if [[ -n "${MMPROJ_PATH:-}" ]]; then
    BASE_ARGS+=(
        "--mmproj" "${MMPROJ_PATH}"
        "--mllm" "yes"
    )
fi

echo "[INFO] Launching llama-server for profile: $PROFILE_NAME"
echo "[INFO] Model: $MODEL_PATH"
[[ -n "${MMPROJ_PATH:-}" ]] && echo "[INFO] Projector: $MMPROJ_PATH"

exec /home/andyfied/opt/llama.cpp/p40-b10988/llama-server "${BASE_ARGS[@]}"
