#!/usr/bin/env bash
set -euo pipefail

profile="$1"
dry_run=""
if (( $# > 1 )); then
    dry_run="$2"
fi
if [[ "$profile" != "p40-coding" && "$profile" != "p40-vision" ]]; then
    echo "usage: switch-p40-model p40-coding|p40-vision [--dry-run]" >&2
    exit 2
fi
if [[ "$dry_run" != "" && "$dry_run" != "--dry-run" ]]; then
    echo "usage: switch-p40-model p40-coding|p40-vision [--dry-run]" >&2
    exit 2
fi

server="/home/andyfied/opt/llama.cpp/p40-b10988/bin/llama-server"
model="/home/andyfied/models/qwen35/Qwen3.5-35B-A3B-UD-Q3_K_XL.gguf"
mmproj="/mnt/scratch/models/qwen35-vision/Qwen3.5-35B-mmproj-F16.gguf"
pid_file="/tmp/p40-vision.pid"
log_file="/tmp/p40-vision-qualification.log"
health_url="http://127.0.0.1:11436/health"

if [[ "$dry_run" == "--dry-run" ]]; then
    printf 'would switch P40 to %s\n' "$profile"
    exit 0
fi

wait_for_port_free() {
    for _ in $(seq 1 30); do
        if ! ss -ltn | grep -q ':11436'; then
            return 0
        fi
        sleep 2
    done
    echo "P40 port 11436 did not become free" >&2
    return 1
}

wait_for_health() {
    for _ in $(seq 1 120); do
        if curl -fsS "$health_url" >/dev/null 2>&1; then
            return 0
        fi
        sleep 2
    done
    echo "P40 service did not become healthy on 11436" >&2
    return 1
}

stop_temporary_vision() {
    if [[ ! -f "$pid_file" ]]; then
        return 0
    fi
    pid="$(<"$pid_file")"
    args="$(ps -p "$pid" -o args= 2>/dev/null || true)"
    if [[ "$args" != *"llama-server"* || "$args" != *"--port 11436"* ]]; then
        echo "refusing to kill unexpected PID recorded in $pid_file" >&2
        return 1
    fi
    kill "$pid"
    for _ in $(seq 1 30); do
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 2
    done
    rm -f "$pid_file"
    wait_for_port_free
}

restore_coding_service() {
    local failed=0
    if ! stop_temporary_vision; then
        failed=1
    fi
    if ! systemctl --user start llama-qwen35.service; then
        failed=1
    fi
    if ! wait_for_health; then
        failed=1
    fi
    return "$failed"
}

fail_vision_switch() {
    echo "$1" >&2
    if restore_coding_service; then
        echo "restored P40 coding service after vision startup failure" >&2
    else
        echo "ERROR: could not restore P40 coding service after vision startup failure" >&2
    fi
    exit 1
}
case "$profile" in
    p40-vision)
        if ! systemctl --user stop llama-qwen35.service; then
            fail_vision_switch "could not stop P40 coding service"
        fi
        if ! wait_for_port_free; then
            fail_vision_switch "P40 port 11436 did not become free for vision startup"
        fi
        nohup "$server" \
            --model "$model" \
            --mmproj "$mmproj" \
            --host 127.0.0.1 --port 11436 -c 65536 \
            --device CUDA0 --main-gpu 0 --split-mode none -ngl 999 \
            --reasoning off --no-reasoning-preserve \
            >"$log_file" 2>&1 &
        vision_pid=$!
        echo "$vision_pid" >"$pid_file"
        if ! kill -0 "$vision_pid" 2>/dev/null; then
            fail_vision_switch "vision server exited during startup"
        fi
        if ! wait_for_health; then
            fail_vision_switch "vision server did not become healthy"
        fi
        ;;
    p40-coding)
        stop_temporary_vision
        systemctl --user start llama-qwen35.service
        wait_for_health
        ;;
esac

echo "P40 profile active: $profile"
